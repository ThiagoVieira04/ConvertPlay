# ConvertFlow - Environment Variables

## Backend
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/convertflow?schema=public"
REDIS_URL="redis://localhost:6379"
CORS_ORIGIN="http://localhost:5173"
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
REQUEST_TIMEOUT_MS=30000
MAX_URL_LENGTH=2048
MAX_ITEMS_PER_JOB=50
JOB_TTL_HOURS=72

## Worker
MAX_CONCURRENT_JOBS=2
JOB_LOCK_DURATION=60000
JOB_STALLED_INTERVAL=30000
FFMPEG_PATH=ffmpeg
FFMPEG_TIMEOUT_MS=300000
STORAGE_DIR=./storage/output
MAX_FILE_SIZE_MB=500
CLEANUP_INTERVAL_MS=3600000
TEMP_FILE_TTL_HOURS=48
