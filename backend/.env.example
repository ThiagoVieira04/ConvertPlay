# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/convertflow?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# CORS
CORS_ORIGIN="http://localhost:5173"

# Rate Limiting
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# Request
REQUEST_TIMEOUT_MS=30000

# Limits
MAX_URL_LENGTH=2048
MAX_ITEMS_PER_JOB=50

# Cleanup
JOB_TTL_HOURS=72
TEMP_FILE_TTL_HOURS=48
ZIP_FILE_TTL_HOURS=24
