generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  queued
  processing
  completed
  failed
  cancelled
}

enum JobItemType {
  video
  playlist
}

enum JobItemStatus {
  pending
  processing
  completed
  failed
}

enum OutputFormat {
  mp3
  mp4
}

model Job {
  id        String    @id @default(uuid())
  sourceUrl String
  type      JobItemType
  format    OutputFormat
  quality   String
  status    JobStatus @default(queued)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items JobItem[]

  @@index([status])
  @@index([createdAt])
}

model JobItem {
  id             String        @id @default(uuid())
  jobId          String
  sourceId       String
  title          String
  position       Int
  status         JobItemStatus @default(pending)
  error          String?
  outputFilePath String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([status])
}
